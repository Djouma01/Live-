rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'coulibalydjouma199@gmail.com';
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'userId',
          'favoriteClubIds',
          'favoriteCompetitionIds',
          'notificationsEnabled',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'favoriteClubIds',
          'favoriteCompetitionIds',
          'notificationsEnabled',
          'kickoffAlerts',
          'goalAlerts',
          'cardAlerts',
          'halftimeFulltimeAlerts',
          'fcmToken',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.favoriteClubIds is list
        && data.favoriteClubIds.size() <= 50
        && (data.favoriteClubIds.size() == 0 || (data.favoriteClubIds[0] is string && data.favoriteClubIds[0].size() <= 128))
        && data.favoriteCompetitionIds is list
        && data.favoriteCompetitionIds.size() <= 50
        && (data.favoriteCompetitionIds.size() == 0 || (data.favoriteCompetitionIds[0] is string && data.favoriteCompetitionIds[0].size() <= 128))
        && data.notificationsEnabled is bool
        && (!('kickoffAlerts' in data) || data.kickoffAlerts is bool)
        && (!('goalAlerts' in data) || data.goalAlerts is bool)
        && (!('cardAlerts' in data) || data.cardAlerts is bool)
        && (!('halftimeFulltimeAlerts' in data) || data.halftimeFulltimeAlerts is bool)
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512))
        && data.updatedAt is timestamp;
    }

    // Connection health check document (read-only single get)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }

    // Public live sports cache (populated exclusively server-side via Admin SDK / Cloud Functions)
    match /live_cache/{cacheId} {
      allow get: if isValidId(cacheId);
      allow list: if resource.data.isPublic == true;
      allow write: if false;
    }

    // Public Sportradar/official competition directory (populated exclusively server-side)
    match /competitions_catalog/{competitionId} {
      allow get: if isValidId(competitionId);
      allow list: if resource.data.isPublic == true;
      allow write: if false;
    }

    // Private user profiles (PII isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if false;

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isValidId(userId)
          && isValidId(prefId)
          && isVerified()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(prefId)
          && isVerified()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPreferences(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'favoriteClubIds',
            'favoriteCompetitionIds',
            'notificationsEnabled',
            'kickoffAlerts',
            'goalAlerts',
            'cardAlerts',
            'halftimeFulltimeAlerts',
            'fcmToken',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(prefId) && isVerified() && isOwner(userId);
      }
    }
  }
}
