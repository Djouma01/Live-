# Sportradar Soccer API v4 (Recommandé : résultats et statistiques internationales rapides)
SPORTRADAR_API_KEY=""
# trial ou production selon votre forfait Sportradar
SPORTRADAR_ACCESS_LEVEL="trial"

# API-Football (api-sports.io) - Optionnel : débloque le Championnat du Mali et des ligues additionnelles
API_FOOTBALL_KEY=""

# football-data.org - Optionnel : source européenne officielle complémentaire
FOOTBALL_DATA_API_KEY=""

# GEMINI_API_KEY: Optionnel / géré par AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injecté par l'environnement d'hébergement
APP_URL="MY_APP_URL"
